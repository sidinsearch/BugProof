{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.sidinsearch/bugproof",
  "title": "BugProof",
  "description": "Capture, replay, and debug failures with portable executable bug artifacts",
  "version": "1.1.21",
  "websiteUrl": "https://github.com/sidinsearch/BugProof",
  "repository": {
    "url": "https://github.com/sidinsearch/BugProof",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/sidinsearch/BugProof/main/assets/icon-512x512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ],
      "theme": "dark"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "bugproof",
      "version": "1.1.21",
      "transport": {
        "type": "stdio"
      }
    }
  ]
