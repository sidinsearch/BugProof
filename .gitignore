# ====================================================================
# BugProof Project & Agent Workspace .gitignore
# ====================================================================

# --------------------------------------------------------------------
# 1. Bug Artifacts & Temp Files
# --------------------------------------------------------------------
# Ignore generated BugProof executable artifacts
*.bug
*.bug/
# Ignore scratch directories used by agents
scratch/
tmp/
temp/
*.tmp
*.temp

# --------------------------------------------------------------------
# 2. Node.js & Dependencies (BugProof App)
# --------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# Ignore coverage and build outputs
coverage/
bugproof/dist/
bugproof/build/

# --------------------------------------------------------------------
# 3. AI & Agent Ecosystem (ECC / gstack / GBrain)
# --------------------------------------------------------------------
# Ignore local installation states
ecc-install-state.json

# GBrain persistent memory databases (keep config, ignore actual DB)
.gbrain/brain.pglite/
.gbrain/migrations/
.gbrain/preferences.json

# Other AI harness state folders
.gemini/
.opencode/
.claude/state/
.agents/state/
.gstack/state/
.gstack/.gstack/
.gstack-worktrees/

# --------------------------------------------------------------------
# 4. Environment & Secrets
# --------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
.vault/

# --------------------------------------------------------------------
# 5. OS & IDE
# --------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace

# --------------------------------------------------------------------
# 6. Executables
# --------------------------------------------------------------------
*.exe
*.dll
*.so
*.dylib

# --------------------------------------------------------------------
# 7. Logs
# --------------------------------------------------------------------
logs/
*.log
