# ====================================================================
# BugProof .npmignore — controls what lands in the published package
# Everything NOT in package.json "files" that could leak is listed here.
# ====================================================================

# Source & build artifacts (dist/ IS included via package.json "files")
src/
tests/
coverage/
docs/

# Config & tooling (tsconfig.json IS in package.json "files" → do NOT ignore it here)
jest.config.js
eslint.config.js
.eslintrc
.eslintrc.json
.prettierrc
.prettierrc.json

# Dev dependencies & lock files
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Development-only scripts
scripts/comprehensive-test.js
scripts/cross-platform-test.js
scripts/e2e-matrix.js
scripts/multi-language-matrix.cjs
scripts/replay-only.js
scripts/ssh_helper.py
scripts/ssh_copy_key.py
scripts/setup_linux_tests.py
scripts/test-icon-reg.js
scripts/release.cjs

# Bug artifacts & test output
*.bug
*.bug/
*.tgz
test-results.json
tests/e2e/results/

# Git & VCS
.git/
.gitignore
tsconfig.tsbuildinfo

# AI & agent tool directories
.agent/
.agents/
.antigravity/
.claude/
.claude.json
.Codex/
.cursor/
.gbrain/
.gemini/
.gstack/
.gstack-checkpoint.txt
.gstack-context.md
.gstack-worktrees/
.opencode/
.vscode/
.windsurf/

# CI/CD & GitHub
.github/

# Temporary & scratch
scratch/
tmp/
temp/
reports/
dummy-project/
examples/

# OS generated
.DS_Store
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

