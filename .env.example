# Environment Configuration for BugProof

## AI Platforms

# Which AI coding platform are you using?
# Options: claude (Claude Code), opencode, cursor, antigravity, openclaw
AI_PLATFORM=claude

# Your model preferences per platform
CLAUDE_MODEL=claude-3-5-sonnet-20241022
OPENCODE_MODEL=gpt-4-turbo
CURSOR_MODEL=claude-3-5-sonnet-20241022
ANTIGRAVITY_MODEL=auto  # auto-selects best model

## gstack Configuration

# gstack command prefix (empty for /qa, "gstack-" for /gstack-qa)
GSTACK_PREFIX=""

# Enable auto-upgrade of gstack on session start
GSTACK_AUTO_UPGRADE=false

# Enable checkpoint mode (auto-commit WIP with context)
GSTACK_CHECKPOINT_MODE=false

# Enable gstack telemetry (anonymous, opt-in)
GSTACK_TELEMETRY=false

## GBrain Configuration

# GBrain connection string (set by /setup-gbrain)
# Formats:
#   - file:path/to/local.db (PGLite local)
#   - postgresql://user:password@host:port/db (Supabase cloud)
GBRAIN_CONNECTION=""

# GBrain trust policy for this repo (read-write, read-only, deny)
# Set once, remembered per repo
GBRAIN_TRUST_MODE=""

# Enable GBrain sync (save session state to private repo)
GBRAIN_SYNC_ENABLED=false

# GBrain sync repo (where session state is backed up)
GBRAIN_SYNC_REPO=""

# Privacy mode for GBrain sync
# Options: all (everything), artifacts-only (no code), off (disabled)
GBRAIN_SYNC_PRIVACY=artifacts-only

## Project Configuration

# Project name
PROJECT_NAME=BugProof

# Project description
PROJECT_DESCRIPTION="Executable bug artifacts — portable, reproducible bug reports"

# Staging URL for /qa and /benchmark
STAGING_URL="https://staging.bugproof.dev"

# Production URL for /land-and-deploy monitoring
PRODUCTION_URL="https://bugproof.dev"

# Deploy command (used by /setup-deploy and /land-and-deploy)
DEPLOY_COMMAND="vercel deploy --prod"

# Test command
TEST_COMMAND="npm test"

# Build command
BUILD_COMMAND="npm run build"

## Browser Configuration

# Browser choice for /browse and /qa
# Options: gstack-browser (default, anti-bot), chrome, chromium, edge
BROWSER_TYPE=gstack-browser

# Enable headed mode (see browser during actions)
BROWSER_HEADED=false

# Chromium binary path (leave empty for auto-detect)
CHROMIUM_PATH=""

# Port for GStack Browser (if using headed mode)
GSTACK_BROWSER_PORT=9222

## Security Configuration

# Enable safety guardrails (/careful)
SAFETY_GUARDRAILS_ENABLED=true

# Enable prompt injection defense (sidebar security)
SECURITY_DEFENSE_ENABLED=true

# Security ensemble mode (faster: none, balanced: ml, strict: deberta)
SECURITY_ENSEMBLE=ml

# Enable emergency kill switch for security
SECURITY_EMERGENCY_OFF=false

## Performance Configuration

# Max concurrent skills (for parallel sprints)
MAX_CONCURRENT_SKILLS=3

# Timeout for long-running skills (minutes)
SKILL_TIMEOUT=30

# Browser command timeout (seconds)
BROWSER_TIMEOUT=120

## Developer Configuration

# Enable gstack debug logging
DEBUG=false

# Enable gstack verbose output
VERBOSE=false

# Git commit template (for checkpoints)
GIT_COMMIT_TEMPLATE="WIP: [gstack-context]"

# Skip confirmation prompts
AUTO_CONFIRM=false

## Analytics & Monitoring

# Enable local analytics
LOCAL_ANALYTICS=true

# Analytics output file
ANALYTICS_FILE=".gstack/analytics.jsonl"

# Enable AI telemetry (Supabase)
TELEMETRY_ENABLED=false

# Telemetry service (if enabled)
TELEMETRY_SERVICE="https://gstack-telemetry.supabase.co"

## Advanced

# Enable experimental features
EXPERIMENTAL=false

# Model-specific overrides
# Format: SKILL_MODEL__skillname=model-name
# Example: SKILL_MODEL__qa=claude-3-opus-20250219
# (Opus is better for QA but slower/more expensive)

# Extra gstack config (YAML format, advanced)
# GSTACK_EXTRA_CONFIG="custom_key: value"

# EOF
